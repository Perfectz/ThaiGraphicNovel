{
  "name": "isekai-thai-quest",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "realtime:session": "node server/realtime-session.mjs",
    "realtime:token": "node server/realtime-session.mjs",
    "whisper:service": "node server/whisper-service.mjs",
    "test:whisper": "node --test server/tests/whisper-service.test.mjs",
    "test:mobile": "node scripts/mobile-smoke.mjs",
    "test:whisper:silence": "node server/tests/whisper-live-smoke.mjs --silence",
    "test:whisper:live": "node server/tests/whisper-live-smoke.mjs",
    "audio:plan": "node scripts/generate-conversation-audio.mjs --dry-run",
    "audio:generate": "node scripts/generate-conversation-audio.mjs",
    "audio:su:plan": "node scripts/generate-stage-one-su-audio.mjs --dry-run",
    "audio:su:generate": "node scripts/generate-stage-one-su-audio.mjs",
    "audio:su:stage2:plan": "node scripts/generate-stage-one-su-audio.mjs --stage=2 --dry-run",
    "audio:su:stage2:generate": "node scripts/generate-stage-one-su-audio.mjs --stage=2",
    "audio:su:all:plan": "node scripts/generate-stage-one-su-audio.mjs --stage=all --dry-run",
    "audio:su:all:generate": "node scripts/generate-stage-one-su-audio.mjs --stage=all",
    "audio:characters:plan": "node scripts/generate-stage-one-su-audio.mjs --stage=characters --dry-run",
    "audio:characters:generate": "node scripts/generate-stage-one-su-audio.mjs --stage=characters",
    "audio:coverage": "node scripts/audio-coverage.mjs",
    "test:multi-engine": "node scripts/test-multi-engine.mjs",
    "promo:og-card": "node scripts/generate-og-card.mjs",
    "promo:record": "node scripts/record-promo.mjs",
    "promo:encode": "node scripts/encode-clips.mjs",
    "voice:gen-demos": "node scripts/gen-voice-demos.mjs",
    "build": "tsc -b && vite build",
    "build:pages": "node scripts/build-pages.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\""
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "react": "latest",
    "react-dom": "latest",
    "three": "^0.184.0",
    "zustand": "latest"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "latest",
    "autoprefixer": "latest",
    "eslint": "^9.18.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "playwright-core": "^1.60.0",
    "postcss": "latest",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "typescript": "latest",
    "typescript-eslint": "^8.20.0",
    "vite": "latest",
    "ws": "^8.21.0"
  }
}
